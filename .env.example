# ==============================================================================
# Dispur College - Professional Studies Department Digital Library
# Environment Variable Template (.env.example)
# ==============================================================================
# Copy this file to `.env.local` for local development and configure the same
# variables in your Vercel (or cloud hosting) project environment settings.
# NEVER commit `.env.local` or expose secret keys in client-side code.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE PROJECT CONFIGURATION (REQUIRED)
# Where to obtain:
#   Supabase Dashboard -> Your Project -> Project Settings -> Data API / API Keys
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Public browser key (safe for client-side use; protected by Row Level Security).
# Copy the "Publishable key" (sb_publishable_...) from Supabase -> Settings -> API Keys.
# (Legacy anon JWT key is also accepted if placed in NEXT_PUBLIC_SUPABASE_ANON_KEY.)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key_here

# Server-only secret key (NEVER prefix with NEXT_PUBLIC_).
# Used strictly on server-side API routes for signed storage URLs, streaming
# private bucket files, deleting storage assets, and managing admin accounts.
# Copy the "Secret key" (sb_secret_...) from Supabase -> Settings -> API Keys.
# (Legacy service_role JWT key is also accepted via SUPABASE_SERVICE_ROLE_KEY.)
SUPABASE_SECRET_KEY=sb_secret_your_secret_key_here

# ------------------------------------------------------------------------------
# 2. DATABASE CONNECTION STRING (OPTIONAL - FOR DIRECT MIGRATIONS / CLI ONLY)
# Where to obtain:
#   Supabase Dashboard -> Project Settings -> Database -> Connection string (URI)
# Note: The Next.js runtime uses the Supabase REST/Auth/Storage SDKs over HTTPS
# and does not require DATABASE_URL at runtime.
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:your_db_password@db.your-project-ref.supabase.co:5432/postgres

# ------------------------------------------------------------------------------
# 3. APPLICATION & UPLOAD CONFIGURATION (OPTIONAL OVERRIDES)
# ------------------------------------------------------------------------------
# Public canonical URL of the deployed website (used for invite redirect links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Maximum allowed upload size for book documents (PDF / EPUB) in Megabytes
MAX_BOOK_FILE_SIZE_MB=50

# Maximum allowed upload size for book cover images (JPG / PNG / WebP) in Megabytes
MAX_COVER_FILE_SIZE_MB=5

# ------------------------------------------------------------------------------
# 4. CLOUDFLARE R2 OBJECT STORAGE (OPTIONAL - FUTURE SCALABILITY ONLY)
# Supabase Storage is the primary cloud storage system out of the box.
# Only populate these if you later migrate object storage to Cloudflare R2.
# Where to obtain:
#   Cloudflare Dashboard -> R2 Object Storage -> Manage R2 API Tokens
# ------------------------------------------------------------------------------
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_KEY_ID=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# CLOUDFLARE_BUCKET_NAME=
